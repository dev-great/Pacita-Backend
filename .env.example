# ── Django ───────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.pacitatiana.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.pacitatiana.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.pacitatiana.com

# ── Square ───────────────────────────────────────────
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
# the EXACT webhook URL registered in the Square dashboard:
SQUARE_WEBHOOK_NOTIFICATION_URL=https://api.pacitatiana.com/api/webhooks/square/
SQUARE_REDIRECT_URL=https://www.pacitatiana.com/thank-you

# ── Lulu Print API (client key & secret from developers.lulu.com) ──
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_USE_SANDBOX=True
LULU_CONTACT_EMAIL=hello@pacitatiana.com
# confirm in the Lulu price calculator (6x9 B&W standard paperback shown):
LULU_POD_PACKAGE_ID=0600X0900.BW.STD.PB.060UW444.G
LULU_SHIPPING_LEVEL=MAIL
# private, stable URLs Lulu can download the print files from:
LULU_INTERIOR_URL=
LULU_COVER_URL=
# True = paid paperback orders automatically create a Lulu print job:
LULU_AUTO_PRINT=False

# ── EmailJS (order notifications to Pacita) ──────────
EMAILJS_SERVICE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_ORDER_TEMPLATE_ID=new_order

# ── Mailchimp (audience sync for newsletter + club signups) ──
# API key: Mailchimp → Account → Extras → API keys (ends in -usXX)
MAILCHIMP_API_KEY=
# Audience ID: Audience → Settings → Audience name and defaults
MAILCHIMP_LIST_ID=
# True = subscribers get a confirm-email first (recommended for compliance)
MAILCHIMP_DOUBLE_OPT_IN=False